{
  "name": "osu-profile-website",
  "version": "1.0.0",
  "description": "Znap- official osu! setup configuration profile website",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve .",
    "build": "tailwindcss -i ./css/styles.css -o ./css/output.css --minify",
    "build:css": "tailwindcss -i ./css/styles.css -o ./css/output.css --watch",
    "typecheck": "tsc -p jsconfig.json",
    "test": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
